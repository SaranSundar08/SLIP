<?xml version="1.0" ?>
<robot name="susag_updated_model" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<xacro:property name="body_color" value="Gazebo/Silver" />
<xacro:property name="wheel_color" value="Gazebo/Black" />
<xacro:property name="lidar_color" value="Gazebo/Yellow" />
<xacro:property name="camera_color" value="Gazebo/Red" />

<gazebo>
  <plugin name="control" filename="libgazebo_ros_control.so"/>
</gazebo>
<gazebo reference="base_link">
  <material>${body_color}</material>
  <mu1>0</mu1>
  <mu2>0</mu2>
  <self_collide>true</self_collide>
  <gravity>true</gravity>
</gazebo>

<gazebo reference="rear_right_wheel_1">
  <material>${wheel_color}</material>
  <mu1>40</mu1>
  <mu2>40</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="front_right_wheel_1">
  <material>${wheel_color}</material>
  <mu1>40</mu1>
  <mu2>40</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="front_left_wheel_1">
  <material>${wheel_color}</material>
  <mu1>40</mu1>
  <mu2>40</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="rear_left_wheel_1">
  <material>${wheel_color}</material>
  <mu1>40</mu1>
  <mu2>40</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="real_sense_1">
  <material>${camera_color}</material>
  <mu1>0</mu1>
  <mu2>0</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="rear_lidar_1">
  <material>${lidar_color}</material>
  <mu1>0</mu1>
  <mu2>0</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo reference="front_lidar_1">
  <material>${lidar_color}</material>
  <mu1>0</mu1>
  <mu2>0</mu2>
  <self_collide>true</self_collide>
</gazebo>

<gazebo>
  <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
    <update_rate>100</update_rate>
    <num_wheel_pairs>2</num_wheel_pairs>

    <!-- LEFT side -->
    <left_joint>front_wheel_left_joint</left_joint>
    <left_joint>rear_wheel_left_joint</left_joint>

    <!-- RIGHT side -->
    <right_joint>front_wheel_right_joint</right_joint>
    <right_joint>rear_wheel_right_joint</right_joint>


    <wheel_separation>0.74</wheel_separation>
    <wheel_diameter>0.33</wheel_diameter>  

    <wheel_separation>0.74</wheel_separation>
    <wheel_diameter>0.33</wheel_diameter>  

    <!-- Limits-->
    <max_wheel_torque>40</max_wheel_torque>
    <max_wheel_acceleration>4.0</max_wheel_acceleration>  <!-- m/s^2, NOT rad/s^2: gazebo_ros_diff_drive converts joint rad/s to linear speed with the wheel radius, then clamps the LINEAR speed change by max_wheel_accel * dt (verified against the plugin source 2026-09-16). This already matches the controller ax_max 4.0 m/s^2; a change to 24.0 on the mistaken rad/s^2 assumption was reverted. -->

    <!-- Outputs -->
    <publish_odom>true</publish_odom>
    <publish_odom_tf>true</publish_odom_tf>
    <publish_wheel_tf>true</publish_wheel_tf>

    <odometry_frame>odom</odometry_frame>
    <robot_base_frame>base_link</robot_base_frame>
  </plugin>
</gazebo>

<!-- Ground-truth pose, independent of the diff_drive plugin's own ideal
     kinematics odometry: diagnostic only, published from Gazebo's actual
     simulated rigid-body pose in the world (global/inertial) frame, so it
     is unaffected by whatever the drive plugin assumes about wheel slip.
     Compare against /odom during a turn-in-place: if they track together,
     any observed drift is a TF/clock issue (see PROJECT_STATUS.md,
     2026-09-10 entry); if they diverge specifically during rotation,
     Gazebo is genuinely simulating skid-steer slip on this 4-wheel,
     no-steering-DOF chassis, the same effect robot_model.py's
     yaw_gain/speed_yaw_loss already models for the real robot. Zero
     noise deliberately: this is ground truth, not a simulated sensor. -->
<gazebo>
  <plugin name="ground_truth_p3d" filename="libgazebo_ros_p3d.so">
    <ros>
      <remapping>odom:=ground_truth/odom</remapping>
    </ros>
    <body_name>base_link</body_name>
    <frame_name>world</frame_name>
    <update_rate>30.0</update_rate>
    <xyz_offset>0 0 0</xyz_offset>
    <rpy_offset>0 0 0</rpy_offset>
    <gaussian_noise>0.0</gaussian_noise>
  </plugin>
</gazebo>


<!-- front lidar -->
<gazebo reference="front_lidar_1">
  <sensor type="ray" name="front_lidar_sensor">
    <pose>0 0 0 0 0 0</pose>
    <update_rate>30</update_rate>
    <visualize>false</visualize>

    <ray>
      <scan>
        <horizontal>
          <samples>720</samples>
          <resolution>1</resolution>
          <min_angle>-3.14</min_angle>
          <max_angle>3.14</max_angle>
        </horizontal>
      </scan>

      <range>
        <min>0.1</min>
        <max>12.0</max>
        <resolution>0.01</resolution>
      </range>
      <noise>
        <type>gaussian</type>
        <mean>0.0</mean>
        <stddev>0.02</stddev>
      </noise>
    </ray>

    <plugin name="gazebo_ros_lidar_front" filename="libgazebo_ros_ray_sensor.so">
      <ros>
        <!-- <namespace>/susag</namespace> -->
        <!-- /front_scan and /rear_scan are consumed as TWO separate costmap
             observation sources, and AMCL localizes on /front_scan alone:
             same topic names as the real robot's ydlidar dual_launch.py, so
             one Nav2 yaml serves sim and hardware. No laser merger: it fed
             AMCL a rear-only "360 deg" scan on the same /scan topic as this
             raw front scan (see PROJECT_STATUS.md 2026-09-09). -->
        <remapping>~/out:=front_scan</remapping>
      </ros>
      <output_type>sensor_msgs/LaserScan</output_type>
      <frame_name>front_lidar_1</frame_name>
    </plugin>
  </sensor>
</gazebo>

<!-- rear lidar -->
<gazebo reference="rear_lidar_1">
  <sensor type="ray" name="rear_lidar_sensor">
    <pose>0 0 0 0 0 0</pose>
    <update_rate>30</update_rate>
    <visualize>false</visualize>

    <ray>
      <scan>
        <horizontal>
          <samples>720</samples>
          <resolution>1</resolution>
          <min_angle>-1.57079632679</min_angle>
          <max_angle>1.57079632679</max_angle>
        </horizontal>
      </scan>

      <range>
        <min>0.1</min>
        <max>20.0</max>
        <resolution>0.01</resolution>
      </range>
      <noise>
        <type>gaussian</type>
        <mean>0.0</mean>
        <stddev>0.02</stddev>
      </noise>
    </ray>

    <plugin name="gazebo_ros_lidar_rear" filename="libgazebo_ros_ray_sensor.so">
      <ros>
        <!-- <namespace>/susag</namespace> -->
        <remapping>~/out:=rear_scan</remapping>
      </ros>
      <output_type>sensor_msgs/LaserScan</output_type>
      <frame_name>rear_lidar_1</frame_name> 
    </plugin>
  </sensor>
</gazebo>

<!-- D435-like depth camera -->
<gazebo reference="real_sense_1">
  <sensor type="depth" name="depth_camera_sensor">
    <update_rate>30</update_rate>            <!-- 30 Hz typical -->
    <always_on>1</always_on>
    <pose>0 0 0 0 0 0</pose>

    <camera name="depth_camera">
      <!-- 86–87° H-FOV ≈ 1.50 rad (your 60° = 1.047 was too narrow) -->
      <horizontal_fov>1.50</horizontal_fov>

      <!-- Use a 16:9 depth mode like the real camera -->
      <image>
        <width>1280</width>                  <!-- or 848 for lighter sim -->
        <height>720</height>                 <!-- 1280x720 matches spec -->
        <format>R8G8B8</format>              <!-- color buffer format (ok) -->
      </image>

      <!-- Clip to realistic working range -->
      <clip>
        <!-- D435 Min-Z ~0.28 m @ max res; use 0.1–0.28 if you need closer -->
        <near>0.28</near>
        <far>10.0</far>                      <!-- workable long range -->
      </clip>

      <!-- Keep depth imager distortion off; Gazebo pinhole model -->
      <distortion>
        <k1>0.0</k1><k2>0.0</k2><k3>0.0</k3>
        <p1>0.0</p1><p2>0.0</p2>
        <center>0.5 0.5</center>
      </distortion>
    </camera>

    <plugin name="depth_camera_plugin" filename="libgazebo_ros_camera.so">
      <ros>
        <namespace>susag</namespace>
        <!-- No remaps. gazebo_ros_camera remap keys must be prefixed with
             the camera_name (see gazebo_ros_depth_camera_demo.world); the
             earlier "~/image", "~/points" keys matched nothing and were
             silently ignored, so the topics have always been the defaults:
               /susag/depth_camera/image_raw
               /susag/depth_camera/depth/image_raw
               /susag/depth_camera/camera_info  (+ depth/camera_info)
               /susag/depth_camera/points
             Nav2 yamls and susag_nav.rviz now use these names. -->
      </ros>

      <camera_name>depth_camera</camera_name>
      <frame_name>real_sense_1</frame_name>

      <!-- Set the real stereo baseline (was 0.07 m) -->
      <hack_baseline>0.05</hack_baseline>

      <!-- Keep consistent with <clip><near> -->
      <min_depth>0.28</min_depth>
    </plugin>

    <!-- Optional noise to mimic <~2% error @ 2 m -->
    <noise>
      <type>gaussian</type>
      <mean>0.0</mean>
      <!-- 2% of 2 m ≈ 4 cm; scale down for sim stability -->
      <stddev>0.02</stddev>   <!-- meters of depth noise; tune 0.005–0.02 -->
    </noise>
  </sensor>
</gazebo>

</robot>
